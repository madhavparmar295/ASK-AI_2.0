# Copy to .env and edit. Never commit .env.
ENV=development                      # development | production
DATABASE_URL=postgresql+psycopg://grievance:grievance@localhost:5432/grievance
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
GOOGLE_CLIENT_ID=                    # OAuth client ID (Workspace "Internal")
ALLOWED_EMAIL_DOMAIN=college.edu
REQUIRE_HD=true                      # require Google Workspace 'hd' claim to match the domain
SESSION_TTL_HOURS=12
COOKIE_SECURE=false                  # must be true in production (HTTPS)
DEV_LOGIN_ENABLED=true               # must be false in production
UNKNOWN_EMAIL_POLICY=reject          # reject | student
API_PREFIX=/api/grievance
CORS_ORIGINS=http://localhost:5173
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Tickets and files (Stage 2)
MAX_TICKETS_PER_DAY=10
MAX_ATTACHMENTS_PER_USER_PER_TICKET=3
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads                 # production: a folder OUTSIDE the web root, included in backups
CLAMAV_ENABLED=false                 # true = scan uploads with the clamscan command
AUTO_CLOSE_RESOLVED_DAYS=3
AUTO_CLOSE_NEEDS_INFO_DAYS=7

# Worker, email, alerts (Stage 3)
WORKER_TICK_SECONDS=60               # the worker runs all jobs every tick
HEARTBEAT_ALERT_MINUTES=60           # email the admin if the worker has not run for this long
WATCHDOG_ENABLED=true
SMTP_HOST=                           # empty = email is NOT configured (in-app notifications still work)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=                           # default: no-reply@<ALLOWED_EMAIL_DOMAIN>
ADMIN_ALERT_EMAIL=                   # default: every active admin
APP_BASE_URL=https://college.edu     # links in emails: <APP_BASE_URL>/grievance/issues/<id>
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_MINUTES=5
CLASSIFY_RATE_LIMIT_PER_MINUTE=60
